{
  "name": "@vuumbora/admin",
  "version": "0.0.0",
  "private": true,
  "description": "Painel administrativo do VuumBora — SPA React + Vite. Primeira peça: login e pré-cadastro de motorista (fase S2 de docs/plano-sistema.md).",
  "type": "module",
  "scripts": {
    "tokens:css": "node scripts/generate-tokens-css.mjs",
    "dev": "npm run tokens:css && vite",
    "build": "npm run tokens:css && tsc --noEmit -p . && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p tsconfig.contract.json",
    "test": "node --import tsx --test --test-concurrency=1 test/*.test.ts"
  },
  "dependencies": {
    "lucide-react": "^1.77.0",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "^7.18.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "vite": "^8.3.8"
  }
}
