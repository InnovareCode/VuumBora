{
  "name": "@vuumbora/api",
  "version": "0.0.0",
  "private": true,
  "description": "API minima do VuumBora — primeira peca real de backend (Fase 5). Hoje so a lista de espera.",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p .",
    "start": "node dist/server.js",
    "typecheck": "tsc -p . --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "test": "node --import tsx --test --test-concurrency=1 test/*.test.ts",
    "migrate": "node scripts/migrate.mjs",
    "waitlist:export": "node scripts/export-waitlist.mjs",
    "waitlist:delete": "node scripts/delete-waitlist.mjs",
    "driver-applications:export": "node scripts/export-driver-applications.mjs",
    "driver-applications:delete": "node scripts/delete-driver-application.mjs",
    "identity:retention": "node scripts/retention-identity.mjs",
    "legal:publish": "node scripts/publish-legal.mjs",
    "create-admin": "node scripts/create-admin.mjs",
    "reissue-2fa-enrollment": "node scripts/reissue-2fa-enrollment.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^12.0.1",
    "@fastify/rate-limit": "^10.2.2",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.10",
    "fastify": "^5.2.1",
    "nodemailer": "^10.6.1",
    "pg": "^8.13.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.11.10",
    "@types/smtp-server": "^3.5.13",
    "smtp-server": "^3.21.7",
    "tsx": "^4.19.2",
    "typescript": "~6.0.3"
  }
}
