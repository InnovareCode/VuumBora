# Copie para `.env` (nunca commitado — ver .gitignore na raiz) e preencha.
# Em produção (Easypanel), estas variáveis entram digitadas na aba
# "Variáveis de Ambiente" do serviço `vuumbora-backend` — nunca num arquivo.
# Ver docs/lista-de-espera.md para o passo a passo completo.

# Obrigatório. String de conexão do Postgres (serviço `vuumbora-banco`).
# Formato: postgres://usuario:senha@host:porta/banco
DATABASE_URL=

# Obrigatório. Origens (domínios) do SITE PÚBLICO autorizadas a chamar
# /v1/waitlist e /v1/driver-applications — sem isso o navegador bloqueia o
# site por CORS (o sintoma parece queda do sistema, não é).
# NUNCA coloque aqui o domínio do painel admin (ver ADMIN_ALLOWED_ORIGINS,
# abaixo) — rotas públicas não usam cookie, e misturar as duas listas foi
# exatamente o furo de CSRF que o Órion encontrou e que esta separação
# corrige (ver hooks/require-admin.ts e app.ts).
# Produção:  https://www.vuumbora.com.br,https://vuumbora.com.br
# Local:     http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# Obrigatório. Origem(ns) do PAINEL ADMIN — a ÚNICA família de rota
# (/v1/admin/*) que usa cookie httpOnly + credentials:true no CORS. Lista
# separada e fechada, de propósito: nunca o domínio do site público.
# Produção:  https://admin.vuumbora.com.br
# Local:     http://localhost:4310 (porta dev do apps/admin)
ADMIN_ALLOWED_ORIGINS=http://localhost:4310

# Opcional — valores padrão abaixo já são razoáveis.
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
WAITLIST_RATE_LIMIT_MAX=5
WAITLIST_RATE_LIMIT_WINDOW_MINUTES=10
# Limite GLOBAL por minuto, por endereco IPv4 ou /64 IPv6 (padrao 100). Vale para toda rota sem cota propria, entre elas as de SESSAO da
# identidade dos apps (refresh, logout, logout-all, reaceite, /me). Rede de operadora com muita gente no mesmo endereco: suba.
# GLOBAL_RATE_LIMIT_MAX=100
# Segundos que o resultado do /healthz fica guardado (0 a 10; padrao 2; 0 desliga): ele nao tem limite de taxa e usa o banco.
# HEALTHZ_CACHE_SECONDS=2

# Painel admin — login e sessão (ver docs/lista-de-espera.md ou o handoff
# do Admin v0 para o passo a passo de criar o primeiro admin).
ADMIN_LOGIN_RATE_LIMIT_MAX=5
ADMIN_LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
ADMIN_SESSION_TTL_HOURS=12
ADMIN_SESSION_ABSOLUTE_TTL_HOURS=168

# Segundo fator (TOTP) do admin. A chave cifra os segredos em repouso:
# gere com `openssl rand -base64 32`. SEM ela, dono e financeiro nao
# conseguem logar (503) — de proposito, falha fechada.
ADMIN_TOTP_ENCRYPTION_KEY=
ADMIN_TOTP_ISSUER=VuumBora Admin
ADMIN_TOTP_MAX_ATTEMPTS=5
ADMIN_TOTP_LOCK_MINUTES=15
ADMIN_LOGIN_CHALLENGE_TTL_MINUTES=10

# Identidade dos apps (/v1/auth/*) — login por e-mail ou ID + senha.
# SEM os dois segredos (>= 32 caracteres cada, diferentes entre si) as rotas
# respondem 503 (falha fechada). Gere com `openssl rand -base64 48`.
# AUTH_PEPPER: chave do HMAC de e-mail/IP nas tabelas de tentativa e acesso.
# AUTH_JWT_SECRET: assina o token de acesso. Nunca logar nenhum dos dois.
AUTH_PEPPER=
AUTH_JWT_SECRET=
# Os dois segredos precisam ser DIFERENTES entre si e ter entropia de gerador
# (o boot recusa 32 letras iguais): sem isso as rotas respondem 503.
# Opcionais (padrões): AUTH_ACCESS_TTL_MINUTES=15 AUTH_REFRESH_TTL_DAYS=30
# AUTH_SESSION_ABSOLUTE_TTL_DAYS=90 AUTH_BCRYPT_COST=12
# AUTH_BCRYPT_COST: NAO preencha em producao (padrao 12). PISO 10 em producao (NODE_ENV=production ou ausente): abaixo disso a
#        identidade dos apps responde 503 e o boot avisa "AUTH_BCRYPT_COST:below_production_floor". Aceita 4 a 15 so em
#        test/development (a suite usa 4 para ser rapida). Subir o custo deixa o login mais lento: refaca a medicao abaixo.
# Login: ATRASO PROGRESSIVO por par (tipo+identificador+IP), sem bloquear a conta inteira:
#        AUTH_LOGIN_DELAY_BASE_SECONDS=1 (1 s, 2 s, 4 s...) AUTH_LOGIN_DELAY_MAX_SECONDS=900 (teto: 15 min).
#        (Substituem AUTH_LOGIN_MAX_FAILURES, AUTH_LOGIN_IDENTIFIER_CEILING e AUTH_LOGIN_WINDOW_MINUTES, que nao existem mais.)
# Cadastro: AUTH_REGISTER_MAX_PER_IDENTIFIER=5 (e-mail canonical: sem +tag, sem pontos do Gmail)
#        AUTH_REGISTER_MAX_PER_IP=30 (balde: IPv4 = endereco, IPv6 = /64) AUTH_REGISTER_WINDOW_MINUTES=60
# Pedidos de codigo: AUTH_CODE_REQUEST_MAX_PER_IDENTIFIER=5 AUTH_CODE_REQUEST_MAX_PER_IP=20
#        AUTH_CODE_REQUEST_WINDOW_MINUTES=60
# Teto GLOBAL de e-mails de identidade por hora (dois baldes: verificacao e redefinicao):
#        AUTH_EMAIL_GLOBAL_MAX_PER_HOUR=100  — ajuste a cota real do provedor SMTP.
# Redefinicao de senha: teto CUMULATIVO de falhas de codigo por conta em 24 h: AUTH_RESET_MAX_FAILURES_PER_DAY=10
# Codigo de e-mail: AUTH_EMAIL_CODE_TTL_MINUTES=15 AUTH_EMAIL_CODE_MIN_INTERVAL_SECONDS=60 AUTH_EMAIL_CODE_MAX_PER_HOUR=5
# Conferencia de codigo (verificar e-mail, redefinir senha): tentativas por PAR (tipo+identificador+IP), reservadas
#        ANTES do bcrypt: AUTH_CODE_CHECK_MAX_PER_PAIR=10 AUTH_CODE_CHECK_WINDOW_MINUTES=15
# TETO GLOBAL DE BCRYPT (por processo; o bcrypt roda em threads, fora do laco de eventos). Opcionais, valores padrao:
# AUTH_BCRYPT_CONCURRENCY=2
# AUTH_BCRYPT_QUEUE_MAX=8
# AUTH_BCRYPT_MAX_PER_ORIGIN=2
#        AUTH_BCRYPT_CONCURRENCY: operacoes de bcrypt SIMULTANEAS na pista dos apps (1 a 8). Padrao: CPUs - 1, no maximo 2.
#        AUTH_BCRYPT_QUEUE_MAX: quantas esperam vaga; alem disso a requisicao responde 503 server_busy + Retry-After: 3.
#          Espera maxima = fila / concorrencia x ~0,5 s (custo 12). A pista do admin e separada e fixa (1 vaga, fila 4).
#        AUTH_BCRYPT_MAX_PER_ORIGIN: lugares de ESPERA que um mesmo IP segura da pista (IPv4 = o endereco; IPv6 = o /48,
#          nao o /64). Sem isto quem manda mais rapido ocupa a fila inteira e o titular recebe 503. Um IP com mais de 2
#          requisicoes de bcrypt ao mesmo tempo recebe 503 nas excedentes (rede com IP compartilhado: suba este valor).
#        ATENCAO AO CONTEINER (Easypanel): CPUs = o que o PROCESSO ENXERGA, que pode ser o numero de nucleos do HOSPEDEIRO e
#          nao a cota do servico. Com cota de CPU abaixo de 3, o padrao pode escolher 2 threads que competem com o laco principal
#          (o /healthz atrasa durante uma rajada). Se o servico tem cota de 1 a 2 CPUs, FIXE AUTH_BCRYPT_CONCURRENCY=1 e
#          meça o /healthz sob rajada na maquina real antes de subir. Mais vagas = mais CPU tomada por login e cadastro.
# Limites POR IP em memoria da identidade dos apps, em DUAS classes (src/lib/ip-rate-limits.ts). Os contadores GRAVADOS no banco
#        (par, e-mail, IP) seguem no /64 e sao outra camada.
#        CREDENCIAIS E CODIGOS (cadastro, login, verificar e-mail, redefinir senha, reenvio, esqueci a senha): cota POR ROTA por
#        endereco IPv4 ou por /64 IPv6 em cada janela, mais um TETO por /48 IPv6 (bloco inteiro), tambem por rota, na mesma janela.
#          AUTH_IP_RATE_LIMIT_MAX=100  AUTH_IP_RATE_LIMIT_WINDOW_MINUTES=15  AUTH_IP_RATE_LIMIT_BLOCK_MAX=1000
#          100 cobre uma rede de operadora com varias dezenas de pessoas no mesmo endereco ao entrar (1 a 3 pedidos por rota cada).
#        SESSAO (refresh, logout, logout-all, reaceite): SEM cota por rota (nao gastam bcrypt; o refresh token tem 256 bits). Valem o
#        limite global (GLOBAL_RATE_LIMIT_MAX, por minuto, por endereco ou /64) e um teto por /48 de 1 minuto:
#          AUTH_SESSION_BLOCK_RATE_LIMIT_MAX=3000
#        Calibre pelos 429 de cada rota nos logs: uma linha {"event":"rate_limited","route":"/v1/auth/login"} por resposta limitada.
# Limites POR ROTA do admin e dos formularios publicos: IPv4 = o endereco, IPv6 = o /48.
# Retencao (cron diario, credencial DONA): npm run identity:retention  (usa MIGRATION_DATABASE_URL)
#
# Termos de Uso e Politica de Privacidade (M-3, migracao 0021). A versao VIGENTE nao e configuracao: mora no banco
# (tabela legal_document_versions) e e publicada pelo operador com a credencial DONA: npm run legal:publish.
# (AUTH_TERMS_VERSION e AUTH_PRIVACY_VERSION NAO existem mais.) O que fica aqui e so ONDE os textos sao servidos:
# o arquivo de cada versao mora em <base>/<terms|privacy>/<passenger|driver>/<versao> e e IMUTAVEL (texto novo = versao nova).
# SEM VALOR PADRAO de proposito (onde hospedar e decisao do dono; a API nao inventa endereco): sem ela o cadastro, o
# reaceite e GET /v1/legal/current respondem 503 consent_unavailable (login e o resto seguem) e o boot AVISA ALTO.
# https obrigatorio em producao; sem credencial, query nem fragmento na URL.
# Exemplo: LEGAL_DOCUMENTS_BASE_URL=https://www.vuumbora.com.br/legal
LEGAL_DOCUMENTS_BASE_URL=
# Opcional: Cache-Control max-age (segundos, 0 a 86400) de GET /v1/legal/current. Padrao 60.
# LEGAL_CACHE_MAX_AGE_SECONDS=60
#
# Segredos obrigatorios (AUTH_PEPPER, AUTH_JWT_SECRET, ADMIN_TOTP_ENCRYPTION_KEY): se faltarem ou forem fracos, a API SOBE e
# a identidade dos apps / o 2FA do admin respondem 503 — mas o boot AVISA ALTO (nomes, nunca valores). Com REQUIRE_SECRETS=true o
# boot FALHA (recomendado em producao DEPOIS de provisionar os tres; padrao desligado para nao derrubar o formulario e o painel).
# REQUIRE_SECRETS=true
#
# Credenciais de banco (revisao S1 rodada 2, I-3): DATABASE_URL = papel restrito vuumbora_api (so ele fica no
# servico da API). MIGRATION_DATABASE_URL = credencial DONA, usada por migrar, create-admin, reissue-2fa-enrollment,
# waitlist:delete, driver-applications:delete, identity:retention e legal:publish — so em tarefa/terminal de operador, NAO no
# ambiente permanente da API (docs/publicar-o-backend.md). Com ela ausente esses scripts avisam e usam DATABASE_URL.
# MIGRATION_DATABASE_URL=

# E-mail (SMTP). Tudo opcional: o dono tambem configura pelo painel (Configuracoes
# > E-mail). ATENCAO (I-1): servidor, porta, usuario e senha formam UMA unidade e a origem de todos e a do
# servidor: com servidor definido no painel, SMTP_PORT/SMTP_USER/SMTP_PASS do ambiente NAO sao usados (a
# credencial da infraestrutura nunca vai para um host digitado no painel). So o remetente (EMAIL_FROM) e
# independente (painel > ambiente). Alterar pelo painel exige senha atual + codigo TOTP do dono. A senha salva
# no painel e cifrada com ADMIN_TOTP_ENCRYPTION_KEY (acima).
# Porta 465 = TLS direto; as demais exigem STARTTLS.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
# So desenvolvimento (ignorada com NODE_ENV=production): libera host em rede
# privada/loopback e conexao sem TLS, para um servidor SMTP falso local.
# SMTP_ALLOW_INSECURE_DEV=true

# Cadastro do motorista (fatias D3/D4). Cota POR ROTA de /v1/driver/* (por minuto, por IPv4 ou /64) e teto por
# CONTA de pedidos de URL de envio de documento por hora.
# DRIVER_ROUTES_RATE_LIMIT_MAX=60
# DRIVER_UPLOAD_URLS_PER_HOUR=30
#
# Armazenamento dos documentos do motorista (padrao S3: Magalu Cloud ou AWS). Sem DOCUMENT_STORAGE_DRIVER o boot
# segue e o envio de documento responde 503 (falha fechada); o motivo vai ao log so com NOMES de variavel.
# A credencial so precisa de PutObject/GetObject/HeadObject no prefixo driver-docs/. Cifragem em repouso: no bucket.
# DOCUMENT_STORAGE_DRIVER=s3
# DOCUMENT_STORAGE_S3_ENDPOINT=https://br-se1.magaluobjects.com
# DOCUMENT_STORAGE_S3_REGION=br-se1
# DOCUMENT_STORAGE_S3_BUCKET=
# DOCUMENT_STORAGE_S3_ACCESS_KEY_ID=
# DOCUMENT_STORAGE_S3_SECRET_ACCESS_KEY=
# DOCUMENT_STORAGE_S3_FORCE_PATH_STYLE=false
# Validade das URLs assinadas de envio e de visualizacao, 1..300 s (padrao 300).
# DOCUMENT_URL_TTL_SECONDS=300
# So desenvolvimento (recusado com NODE_ENV=production): servidor local em memoria. PUBLIC_URL e o endereco que o
# app enxerga (ex.: http://10.0.2.2:3102 no emulador Android, com HOST=0.0.0.0 e PORT=3102).
# DOCUMENT_STORAGE_DRIVER=local
# DOCUMENT_STORAGE_LOCAL_HOST=127.0.0.1
# DOCUMENT_STORAGE_LOCAL_PORT=3102
# DOCUMENT_STORAGE_LOCAL_PUBLIC_URL=

# Geografia e cotacao do passageiro (M4, fatias G3/G4). Nada aqui derruba o boot: ausente ou invalido, a rota que depende
# falha fechada e o motivo vai ao log so com NOMES de variavel.
# Token do Mapbox SO do servidor (V1: nunca o EXPO_PUBLIC_*, nunca em bundle de app; escopo so de busca e rota).
# Sem ele: busca, pino e cotacao respondem 503 geo_unavailable; area e categorias seguem.
# MAPBOX_SERVER_TOKEN=
# Segredo do HMAC da cotacao (N9), >= 32 caracteres (ex.: openssl rand -base64 48). Sem ele, cotar responde 503.
# QUOTE_SIGNING_SECRET=
# N8: so "true" deixa a tarifa de TESTE cotar (desenvolvimento e homologacao). Em producao fica DESLIGADA: com so a
# tarifa de teste publicada, POST /v1/quotes responde 503 fare_not_configured.
# ALLOW_TEST_FARES=false
# Cache das respostas do Mapbox (0..600 s). PADRAO 0 (desligado): os termos do Mapbox para resultado temporario
# restringem guarda-lo. So ligue depois da decisao do dono sobre o plano/acordo com o Mapbox.
# GEO_CACHE_TTL_SECONDS=0
# Limites POR CONTA, por minuto e por dia (janela de 24 h), e teto por IP em cada rota.
# GEO_SEARCH_PER_MINUTE=60
# GEO_SEARCH_PER_DAY=600
# GEO_REVERSE_PER_MINUTE=30
# GEO_REVERSE_PER_DAY=300
# QUOTES_PER_MINUTE=20
# QUOTES_PER_DAY=150
# GEO_ROUTES_RATE_LIMIT_MAX=300
# Teto GLOBAL de chamadas ao Mapbox por dia (de Natal), por motor; 0 desliga o motor. Esgotado: 503 geo_unavailable e o
# evento geo_budget_exhausted no log ate o dia seguinte. Ajuste ao plano contratado e ponha alerta de cobranca no Mapbox.
# GEO_DAILY_BUDGET_GEOCODING=2000
# GEO_DAILY_BUDGET_SEARCHBOX=1000
# GEO_DAILY_BUDGET_REVERSE=1000
# GEO_DAILY_BUDGET_DIRECTIONS=3000
# Tempo maximo de cada chamada ao Mapbox (500..10000 ms) e perfil da Directions (driving-traffic | driving).
# MAPBOX_TIMEOUT_MS=3000
# MAPBOX_DIRECTIONS_PROFILE=driving-traffic
