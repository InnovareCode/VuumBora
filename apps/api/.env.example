# Copie para `.env` (nunca commitado — ver .gitignore na raiz) e preencha.
# Em produção (Easypanel), estas variáveis entram digitadas na aba
# "Variáveis de Ambiente" do serviço `vuumbora-backend` — nunca num arquivo.
# Ver docs/lista-de-espera.md para o passo a passo completo.

# Obrigatório. String de conexão do Postgres (serviço `vuumbora-banco`).
# Formato: postgres://usuario:senha@host:porta/banco
DATABASE_URL=

# Obrigatório. Origens (domínios) do SITE PÚBLICO autorizadas a chamar
# /v1/waitlist e /v1/driver-applications — sem isso o navegador bloqueia o
# site por CORS (o sintoma parece queda do sistema, não é).
# NUNCA coloque aqui o domínio do painel admin (ver ADMIN_ALLOWED_ORIGINS,
# abaixo) — rotas públicas não usam cookie, e misturar as duas listas foi
# exatamente o furo de CSRF que o Órion encontrou e que esta separação
# corrige (ver hooks/require-admin.ts e app.ts).
# Produção:  https://www.vuumbora.com.br,https://vuumbora.com.br
# Local:     http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# Obrigatório. Origem(ns) do PAINEL ADMIN — a ÚNICA família de rota
# (/v1/admin/*) que usa cookie httpOnly + credentials:true no CORS. Lista
# separada e fechada, de propósito: nunca o domínio do site público.
# Produção:  https://admin.vuumbora.com.br
# Local:     http://localhost:4310 (porta dev do apps/admin)
ADMIN_ALLOWED_ORIGINS=http://localhost:4310

# Opcional — valores padrão abaixo já são razoáveis.
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
WAITLIST_RATE_LIMIT_MAX=5
WAITLIST_RATE_LIMIT_WINDOW_MINUTES=10

# Painel admin — login e sessão (ver docs/lista-de-espera.md ou o handoff
# do Admin v0 para o passo a passo de criar o primeiro admin).
ADMIN_LOGIN_RATE_LIMIT_MAX=5
ADMIN_LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
ADMIN_SESSION_TTL_HOURS=12
ADMIN_SESSION_ABSOLUTE_TTL_HOURS=168

# Segundo fator (TOTP) do admin. A chave cifra os segredos em repouso:
# gere com `openssl rand -base64 32`. SEM ela, dono e financeiro nao
# conseguem logar (503) — de proposito, falha fechada.
ADMIN_TOTP_ENCRYPTION_KEY=
ADMIN_TOTP_ISSUER=VuumBora Admin
ADMIN_TOTP_MAX_ATTEMPTS=5
ADMIN_TOTP_LOCK_MINUTES=15
ADMIN_LOGIN_CHALLENGE_TTL_MINUTES=10

# Identidade dos apps (/v1/auth/*) — login por e-mail ou ID + senha.
# SEM os dois segredos (>= 32 caracteres cada, diferentes entre si) as rotas
# respondem 503 (falha fechada). Gere com `openssl rand -base64 48`.
# AUTH_PEPPER: chave do HMAC de e-mail/IP nas tabelas de tentativa e acesso.
# AUTH_JWT_SECRET: assina o token de acesso. Nunca logar nenhum dos dois.
AUTH_PEPPER=
AUTH_JWT_SECRET=
# Os dois segredos precisam ser DIFERENTES entre si e ter entropia de gerador
# (o boot recusa 32 letras iguais): sem isso as rotas respondem 503.
# Opcionais (padrões): AUTH_ACCESS_TTL_MINUTES=15 AUTH_REFRESH_TTL_DAYS=30
# AUTH_SESSION_ABSOLUTE_TTL_DAYS=90 AUTH_BCRYPT_COST=12
# Login: ATRASO PROGRESSIVO por par (tipo+identificador+IP), sem bloquear a conta inteira:
#        AUTH_LOGIN_DELAY_BASE_SECONDS=1 (1 s, 2 s, 4 s...) AUTH_LOGIN_DELAY_MAX_SECONDS=900 (teto: 15 min).
#        (Substituem AUTH_LOGIN_MAX_FAILURES, AUTH_LOGIN_IDENTIFIER_CEILING e AUTH_LOGIN_WINDOW_MINUTES, que nao existem mais.)
# Cadastro: AUTH_REGISTER_MAX_PER_IDENTIFIER=5 (e-mail canonical: sem +tag, sem pontos do Gmail)
#        AUTH_REGISTER_MAX_PER_IP=30 (balde: IPv4 = endereco, IPv6 = /64) AUTH_REGISTER_WINDOW_MINUTES=60
# Pedidos de codigo: AUTH_CODE_REQUEST_MAX_PER_IDENTIFIER=5 AUTH_CODE_REQUEST_MAX_PER_IP=20
#        AUTH_CODE_REQUEST_WINDOW_MINUTES=60
# Teto GLOBAL de e-mails de identidade por hora (dois baldes: verificacao e redefinicao):
#        AUTH_EMAIL_GLOBAL_MAX_PER_HOUR=100  — ajuste a cota real do provedor SMTP.
# Redefinicao de senha: teto CUMULATIVO de falhas de codigo por conta em 24 h: AUTH_RESET_MAX_FAILURES_PER_DAY=10
# Codigo de e-mail: AUTH_EMAIL_CODE_TTL_MINUTES=15 AUTH_EMAIL_CODE_MIN_INTERVAL_SECONDS=60 AUTH_EMAIL_CODE_MAX_PER_HOUR=5
# Conferencia de codigo (verificar e-mail, redefinir senha): tentativas por PAR (tipo+identificador+IP), reservadas
#        ANTES do bcrypt: AUTH_CODE_CHECK_MAX_PER_PAIR=10 AUTH_CODE_CHECK_WINDOW_MINUTES=15
# TETO GLOBAL DE BCRYPT (por processo; o bcrypt roda em threads, fora do laco de eventos):
#        AUTH_BCRYPT_CONCURRENCY=2  operacoes simultaneas na pista dos apps (1 a 8; padrao: CPUs - 1, no maximo 2).
#        AUTH_BCRYPT_QUEUE_MAX=8    quantas esperam vaga; a seguinte responde 503 server_busy + Retry-After: 3.
#        Espera maxima = fila / concorrencia x ~0,5 s (custo 12). A pista do admin e separada e fixa (1 vaga, fila 4).
#        Mais vagas = mais CPU tomada por login/cadastro numa rajada; ajuste ao numero de CPUs do servidor.
# AUTH_IP_RATE_LIMIT_MAX=30 AUTH_IP_RATE_LIMIT_WINDOW_MINUTES=15
# Retencao (cron diario, credencial DONA): npm run identity:retention  (usa MIGRATION_DATABASE_URL)
#
# Aceite dos Termos de Uso e da Politica de Privacidade no cadastro: a VERSAO VIGENTE de cada documento.
# SEM VALOR PADRAO de proposito (os textos e as versoes ainda nao existem; a API nao inventa): sem as duas o
# CADASTRO responde 503 consent_unavailable (login e o resto seguem). Formato: letras/digitos e . _ : + - (ate 64).
AUTH_TERMS_VERSION=
AUTH_PRIVACY_VERSION=
#
# Segredos obrigatorios (AUTH_PEPPER, AUTH_JWT_SECRET, ADMIN_TOTP_ENCRYPTION_KEY): se faltarem ou forem fracos, a API SOBE e
# a identidade dos apps / o 2FA do admin respondem 503 — mas o boot AVISA ALTO (nomes, nunca valores). Com REQUIRE_SECRETS=true o
# boot FALHA (recomendado em producao DEPOIS de provisionar os tres; padrao desligado para nao derrubar o formulario e o painel).
# REQUIRE_SECRETS=true
#
# Credenciais de banco (revisao S1 rodada 2, I-3): DATABASE_URL = papel restrito vuumbora_api (so ele fica no
# servico da API). MIGRATION_DATABASE_URL = credencial DONA, usada por migrar, create-admin, reissue-2fa-enrollment,
# waitlist:delete, driver-applications:delete e identity:retention — so em tarefa/terminal de operador, NAO no
# ambiente permanente da API (docs/publicar-o-backend.md). Com ela ausente esses scripts avisam e usam DATABASE_URL.
# MIGRATION_DATABASE_URL=

# E-mail (SMTP). Tudo opcional: o dono tambem configura pelo painel (Configuracoes
# > E-mail). ATENCAO (I-1): servidor, porta, usuario e senha formam UMA unidade e a origem de todos e a do
# servidor: com servidor definido no painel, SMTP_PORT/SMTP_USER/SMTP_PASS do ambiente NAO sao usados (a
# credencial da infraestrutura nunca vai para um host digitado no painel). So o remetente (EMAIL_FROM) e
# independente (painel > ambiente). Alterar pelo painel exige senha atual + codigo TOTP do dono. A senha salva
# no painel e cifrada com ADMIN_TOTP_ENCRYPTION_KEY (acima).
# Porta 465 = TLS direto; as demais exigem STARTTLS.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
# So desenvolvimento (ignorada com NODE_ENV=production): libera host em rede
# privada/loopback e conexao sem TLS, para um servidor SMTP falso local.
# SMTP_ALLOW_INSECURE_DEV=true
