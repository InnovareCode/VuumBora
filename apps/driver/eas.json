      "distribution": "internal",
      "environment": "development",
      "env": {
        "VUUMBORA_BUILD_PROFILE": "development"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "env": {
        "VUUMBORA_BUILD_PROFILE": "preview"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
