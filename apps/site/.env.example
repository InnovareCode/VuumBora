# Copie para .env.local (nunca commitado) para apontar o formulário da
# lista de espera para um backend real em dev.
#
# Lido em BUILD TIME (next build gera exportação estática, sem servidor
# depois) — ver src/lib/waitlist-client.ts. Precisa do prefixo NEXT_PUBLIC_
# para o Next embutir o valor no bundle que roda no navegador.
#
# Sem esta variável, o formulário mostra um aviso honesto ("ainda não está
# pronto") em vez de tentar chamar uma URL que não existe — ver
# docs/lista-de-espera.md §7 (o backend `apps/api` ainda não foi publicado
# em 19/11/2026).
NEXT_PUBLIC_WAITLIST_API_URL=http://localhost:3000
