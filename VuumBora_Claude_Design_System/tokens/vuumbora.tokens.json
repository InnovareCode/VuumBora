{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "VuumBora Design Tokens",
  "version": "1.3.0",
  "status": "approved-measured-from-logo",
  "notes": "Paleta medida pixel a pixel na logomarca (System.Drawing + CIEDE2000) e validada em WCAG AA; aprovada pelo dono em 18/11/2026. Origem de cada cor e tabela de contraste em docs/identidade-visual.md. Fonte unica: packages/tokens deriva deste arquivo. Nao duplicar HEX em outro lugar. Tipografia: Plus Jakarta Sans (decisao do dono, 18/11/2026, analise completa em docs/tipografia.md) substitui Inter. typography.family e um grupo de 4 fontFamily (um por peso: regular/medium/semibold/bold) porque fonte estatica no Android nao mapeia peso por fontWeight dentro de uma familia so.",
  "color": {
    "brand": {
      "yellow": {
        "$type": "color",
        "$value": "#FFCC00"
      },
      "yellowPressed": {
        "$type": "color",
        "$value": "#FDB601"
      },
      "yellowDeep": {
        "$type": "color",
        "$value": "#FEA101"
      },
      "navy": {
        "$type": "color",
        "$value": "#0C111B"
      },
      "white": {
        "$type": "color",
        "$value": "#FFFFFF"
      }
    },
    "background": {
      "base": {
        "$type": "color",
        "$value": "#070D18"
      },
      "surface": {
        "$type": "color",
        "$value": "#111B2A"
      },
      "elevated": {
        "$type": "color",
        "$value": "#192536"
      },
      "input": {
        "$type": "color",
        "$value": "#1F2B3D"
      }
    },
    "text": {
      "primary": {
        "$type": "color",
        "$value": "#FFFFFF"
      },
      "secondary": {
        "$type": "color",
        "$value": "#B9C4D2"
      },
      "muted": {
        "$type": "color",
        "$value": "#8D9AAC"
      },
      "onYellow": {
        "$type": "color",
        "$value": "#0C111B"
      },
      "onLightMuted": {
        "$type": "color",
        "$value": "#4A5568",
        "$description": "Direção de arte §4: texto de apoio sobre gradient.searchLight (pílula de destino). 6,66:1 sobre #EEF1F9."
      }
    },
    "border": {
      "default": {
        "$type": "color",
        "$value": "#2D3A4C"
      },
      "emphasis": {
        "$type": "color",
        "$value": "#46566C"
      },
      "strong": {
        "$type": "color",
        "$value": "#66768E"
      },
      "subtle": {
        "$type": "color",
        "$value": "#1E2A3B",
        "$description": "Direção de arte (docs/direcao-de-arte.md §4, stroke.edgeBottom): lado inferior/laterais da borda com luz de cima (top-lit edge). border.emphasis faz o lado de cima (stroke.edgeTop)."
      }
    },
    "highlight": {
      "ctaRimLight": {
        "$type": "color",
        "$value": "rgba(255,255,255,0.60)",
        "$description": "Brilho de 1px no topo do CTA (stroke.ctaRim) — medido na referência, não é halo."
      },
      "ctaRimWarm": {
        "$type": "color",
        "$value": "rgba(255,236,120,0.70)",
        "$description": "Brilho de 1px na base do CTA (stroke.ctaRim)."
      },
      "selectedGlow": {
        "$type": "color",
        "$value": "rgba(255,204,0,0.30)",
        "$description": "Halo do card selecionado (glow.selected)."
      }
    },
    "overlay": {
      "glassOnMap": {
        "$type": "color",
        "$value": "rgba(17,27,42,0.88)",
        "$description": "Chip/cartão sobre mapa ou foto — opaco, SEM blur (ver docs/direcao-de-arte.md §5)."
      },
      "tabBar": {
        "$type": "color",
        "$value": "rgba(9,15,27,0.94)",
        "$description": "Tab bar translúcida sobre conteúdo rolado."
      }
    },
    "semantic": {
      "success": {
        "$type": "color",
        "$value": "#22C55E"
      },
      "danger": {
        "$type": "color",
        "$value": "#FF6B75"
      },
      "dangerFill": {
        "$type": "color",
        "$value": "#D02A38"
      },
      "warning": {
        "$type": "color",
        "$value": "#FEA101"
      },
      "info": {
        "$type": "color",
        "$value": "#6EA8FF"
      }
    },
    "map": {
      "route": {
        "$type": "color",
        "$value": "#FFCC00"
      },
      "pickup": {
        "$type": "color",
        "$value": "#22C55E"
      },
      "destination": {
        "$type": "color",
        "$value": "#FF6B75"
      },
      "userLocation": {
        "$type": "color",
        "$value": "#6EA8FF"
      }
    }
  },
  "spacing": {
    "0": {
      "$type": "dimension",
      "$value": "0px"
    },
    "1": {
      "$type": "dimension",
      "$value": "4px"
    },
    "2": {
      "$type": "dimension",
      "$value": "8px"
    },
    "3": {
      "$type": "dimension",
      "$value": "12px"
    },
    "4": {
      "$type": "dimension",
      "$value": "16px"
    },
    "5": {
      "$type": "dimension",
      "$value": "20px"
    },
    "6": {
      "$type": "dimension",
      "$value": "24px"
    },
    "7": {
      "$type": "dimension",
      "$value": "32px"
    },
    "8": {
      "$type": "dimension",
      "$value": "40px"
    },
    "9": {
      "$type": "dimension",
      "$value": "48px"
    },
    "10": {
      "$type": "dimension",
      "$value": "64px"
    }
  },
  "radius": {
    "sm": {
      "$type": "dimension",
      "$value": "8px"
    },
    "md": {
      "$type": "dimension",
      "$value": "12px"
    },
    "lg": {
      "$type": "dimension",
      "$value": "16px"
    },
    "xl": {
      "$type": "dimension",
      "$value": "20px"
    },
    "xxl": {
      "$type": "dimension",
      "$value": "24px"
    },
    "pill": {
      "$type": "dimension",
      "$value": "999px"
    }
  },
  "typography": {
    "family": {
      "regular": {
        "$type": "fontFamily",
        "$value": "PlusJakartaSans_400Regular"
      },
      "medium": {
        "$type": "fontFamily",
        "$value": "PlusJakartaSans_500Medium"
      },
      "semibold": {
        "$type": "fontFamily",
        "$value": "PlusJakartaSans_600SemiBold"
      },
      "bold": {
        "$type": "fontFamily",
        "$value": "PlusJakartaSans_700Bold"
      }
    },
    "size": {
      "caption": {
        "$type": "dimension",
        "$value": "12px"
      },
      "small": {
        "$type": "dimension",
        "$value": "14px"
      },
      "body": {
        "$type": "dimension",
        "$value": "16px"
      },
      "subtitle": {
        "$type": "dimension",
        "$value": "18px"
      },
      "title": {
        "$type": "dimension",
        "$value": "22px"
      },
      "heading": {
        "$type": "dimension",
        "$value": "28px"
      },
      "display": {
        "$type": "dimension",
        "$value": "34px"
      }
    },
    "weight": {
      "regular": {
        "$type": "fontWeight",
        "$value": 400
      },
      "medium": {
        "$type": "fontWeight",
        "$value": 500
      },
      "semibold": {
        "$type": "fontWeight",
        "$value": 600
      },
      "bold": {
        "$type": "fontWeight",
        "$value": 700
      }
    }
  },
  "layout": {
    "screenPadding": {
      "$type": "dimension",
      "$value": "20px"
    },
    "screenPaddingCompact": {
      "$type": "dimension",
      "$value": "16px",
      "$description": "Direção de arte §4/§6: largura < 375pt. screenPadding (20) continua a partir de 375."
    },
    "touchTarget": {
      "$type": "dimension",
      "$value": "44px"
    },
    "buttonHeight": {
      "$type": "dimension",
      "$value": "52px"
    },
    "buttonHeightProminent": {
      "$type": "dimension",
      "$value": "56px",
      "$description": "CTA principal da tela (direção de arte §4/§9 item 3). 52 (buttonHeight) quando a altura da janela < 640pt."
    },
    "inputHeight": {
      "$type": "dimension",
      "$value": "52px"
    },
    "searchHeight": {
      "$type": "dimension",
      "$value": "60px",
      "$description": "Pílula de destino (direção de arte §4). 52 em < 360pt de largura."
    },
    "searchHeightCompact": {
      "$type": "dimension",
      "$value": "52px"
    },
    "bottomNavigationHeight": {
      "$type": "dimension",
      "$value": "68px"
    },
    "mockChipHeight": {
      "$type": "dimension",
      "$value": "20px",
      "$description": "Altura do MockBadge neutro (direção de arte §4, mock.chip)."
    }
  },
  "opacity": {
    "disabled": {
      "$type": "number",
      "$value": 0.45
    },
    "scrim": {
      "$type": "number",
      "$value": 0.65
    }
  },
  "gradient": {
    "brand": {
      "$type": "gradient",
      "$value": [
        {
          "color": "#FED202",
          "position": 0
        },
        {
          "color": "#FEA101",
          "position": 1
        }
      ],
      "$description": "Gradiente medido no logo (p95 -> p5). So em splash, hero e ilustracao. Nunca sob texto."
    },
    "cta": {
      "$type": "gradient",
      "$value": [
        { "color": "#FED202", "position": 0 },
        { "color": "#FFCC00", "position": 0.45 },
        { "color": "#FDB601", "position": 1 }
      ],
      "$description": "Direção de arte §4/§9 item 3. Botão primário (ButtonCore variant=primary). Medido P05 #FDD201->#FEB702 e P01 #FBD100->#FEB904. Texto sempre text.onYellow. Pressionado = brand.yellowPressed chapado (sem gradiente)."
    },
    "surfaceRaised": {
      "$type": "gradient",
      "$value": [
        { "color": "#132033", "position": 0 },
        { "color": "#0F1A28", "position": 1 }
      ],
      "$description": "Direção de arte §4/§9 item 6. Card, atalho, linha de lista. Vertical (180°). Medido P03: #121F2F->#0F1A29. Quem dá volume é border.emphasis/border.subtle (stroke.edgeTop/edgeBottom), não o gradiente."
    },
    "surfaceOverlay": {
      "$type": "gradient",
      "$value": [
        { "color": "#1D2B40", "position": 0 },
        { "color": "#152132", "position": 1 }
      ],
      "$description": "Direção de arte §4. Botão secundário cheio, botão de ícone, CTA desabilitado. Medido no motorista: #273245->#232E3E."
    },
    "searchLight": {
      "$type": "gradient",
      "$value": [
        { "color": "#FEFEFE", "position": 0 },
        { "color": "#EEF1F9", "position": 1 }
      ],
      "$description": "Direção de arte §4/§9 item 1. Pílula de destino (busca) — único elemento claro da tela, substitui o fundo amarelo. Texto sempre navy (color.brand.navy): 16,72:1."
    },
    "screen": {
      "$type": "gradient",
      "$value": [
        { "color": "#0E1A2E", "position": 0 },
        { "color": "#070D18", "position": 1 }
      ],
      "$description": "Direção de arte §4/§9 item 6. Brilho de topo da tela. Aproximação LINEAR vertical do radial medido (radial-gradient 120% 420px at 50% -60px, #0E1A2E -> transparente sobre background.base) — expo-linear-gradient só faz linear; ver docs/direcao-de-arte.md §5. Só em telas com cabeçalho na área escura. Nunca sobre mapa."
    }
  },
  "elevation": {
    "1": {
      "$type": "shadow",
      "$value": [{ "offsetX": 0, "offsetY": 2, "blurRadius": 6, "color": "rgba(0,0,0,0.35)" }],
      "$description": "Card sobre fundo. Quase invisível sobre background.base — quem separa o card é a borda (stroke.edgeTop)."
    },
    "2": {
      "$type": "shadow",
      "$value": [{ "offsetX": 0, "offsetY": 8, "blurRadius": 20, "color": "rgba(0,0,0,0.45)" }],
      "$description": "Elemento sobre mapa ou foto (balão, pílula de destino, cartão de instrução)."
    },
    "3": {
      "$type": "shadow",
      "$value": [{ "offsetX": 0, "offsetY": -12, "blurRadius": 28, "color": "rgba(0,0,0,0.50)" }],
      "$description": "Bottom sheet e tab bar (sombra para cima)."
    },
    "cta": {
      "$type": "shadow",
      "$value": [{ "offsetX": 0, "offsetY": 4, "blurRadius": 12, "color": "rgba(0,0,0,0.45)" }],
      "$description": "Sombra escura sob o CTA. Sem cor."
    }
  },
  "glow": {
    "selected": {
      "$type": "shadow",
      "$value": [{ "offsetX": 0, "offsetY": 0, "blurRadius": 8, "spreadDistance": 1, "color": "rgba(255,204,0,0.30)" }],
      "$description": "Direção de arte §4/§9 item 4. Card selecionado (categoria, pagamento). Junto com borda 2pt brand.yellow."
    }
  }
}
