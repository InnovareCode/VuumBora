{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "VuumBora Design Tokens",
  "version": "1.2.0",
  "status": "approved-measured-from-logo",
  "notes": "Paleta medida pixel a pixel na logomarca (System.Drawing + CIEDE2000) e validada em WCAG AA; aprovada pelo dono em 18/11/2026. Origem de cada cor e tabela de contraste em docs/identidade-visual.md. Fonte unica: packages/tokens deriva deste arquivo. Nao duplicar HEX em outro lugar. Tipografia: Plus Jakarta Sans (decisao do dono, 18/11/2026, analise completa em docs/tipografia.md) substitui Inter. typography.family e um grupo de 4 fontFamily (um por peso: regular/medium/semibold/bold) porque fonte estatica no Android nao mapeia peso por fontWeight dentro de uma familia so.",
  "color": {
    "brand": {
      "yellow": {
        "$type": "color",
        "$value": "#FFCC00"
      },
      "yellowPressed": {
        "$type": "color",
        "$value": "#FDB601"
      },
      "yellowDeep": {
        "$type": "color",
        "$value": "#FEA101"
      },
      "navy": {
        "$type": "color",
        "$value": "#0C111B"
      },
      "white": {
        "$type": "color",
        "$value": "#FFFFFF"
      }
    },
    "background": {
      "base": {
        "$type": "color",
        "$value": "#070D18"
      },
      "surface": {
        "$type": "color",
        "$value": "#111B2A"
      },
      "elevated": {
        "$type": "color",
        "$value": "#192536"
      },
      "input": {
        "$type": "color",
        "$value": "#1F2B3D"
      }
    },
    "text": {
      "primary": {
        "$type": "color",
        "$value": "#FFFFFF"
      },
      "secondary": {
        "$type": "color",
        "$value": "#B9C4D2"
      },
      "muted": {
        "$type": "color",
        "$value": "#8D9AAC"
      },
      "onYellow": {
        "$type": "color",
        "$value": "#0C111B"
      }
    },
    "border": {
      "default": {
        "$type": "color",
        "$value": "#2D3A4C"
      },
      "emphasis": {
        "$type": "color",
        "$value": "#46566C"
      },
      "strong": {
        "$type": "color",
        "$value": "#66768E"
      }
    },
    "semantic": {
      "success": {
        "$type": "color",
        "$value": "#22C55E"
      },
      "danger": {
        "$type": "color",
        "$value": "#FF6B75"
      },
      "dangerFill": {
        "$type": "color",
        "$value": "#D02A38"
      },
      "warning": {
        "$type": "color",
        "$value": "#FEA101"
      },
      "info": {
        "$type": "color",
        "$value": "#6EA8FF"
      }
    },
    "map": {
      "route": {
        "$type": "color",
        "$value": "#FFCC00"
      },
      "pickup": {
        "$type": "color",
        "$value": "#22C55E"
      },
      "destination": {
        "$type": "color",
        "$value": "#FF6B75"
      },
      "userLocation": {
        "$type": "color",
        "$value": "#6EA8FF"
      }
    }
  },
  "spacing": {
    "0": {
      "$type": "dimension",
      "$value": "0px"
    },
    "1": {
      "$type": "dimension",
      "$value": "4px"
    },
    "2": {
      "$type": "dimension",
      "$value": "8px"
    },
    "3": {
      "$type": "dimension",
      "$value": "12px"
    },
    "4": {
      "$type": "dimension",
      "$value": "16px"
    },
    "5": {
      "$type": "dimension",
      "$value": "20px"
    },
    "6": {
      "$type": "dimension",
      "$value": "24px"
    },
    "7": {
      "$type": "dimension",
      "$value": "32px"
    },
    "8": {
      "$type": "dimension",
      "$value": "40px"
    },
    "9": {
      "$type": "dimension",
      "$value": "48px"
    },
    "10": {
      "$type": "dimension",
      "$value": "64px"
    }
  },
  "radius": {
    "sm": {
      "$type": "dimension",
      "$value": "8px"
    },
    "md": {
      "$type": "dimension",
      "$value": "12px"
    },
    "lg": {
      "$type": "dimension",
      "$value": "16px"
    },
    "xl": {
      "$type": "dimension",
      "$value": "20px"
    },
    "xxl": {
      "$type": "dimension",
      "$value": "24px"
    },
    "pill": {
      "$type": "dimension",
      "$value": "999px"
    }
  },
  "typography": {
    "family": {
      "regular": {
        "$type": "fontFamily",
        "$value": "PlusJakartaSans_400Regular"
      },
      "medium": {
        "$type": "fontFamily",
        "$value": "PlusJakartaSans_500Medium"
      },
      "semibold": {
        "$type": "fontFamily",
        "$value": "PlusJakartaSans_600SemiBold"
      },
      "bold": {
        "$type": "fontFamily",
        "$value": "PlusJakartaSans_700Bold"
      }
    },
    "size": {
      "caption": {
        "$type": "dimension",
        "$value": "12px"
      },
      "small": {
        "$type": "dimension",
        "$value": "14px"
      },
      "body": {
        "$type": "dimension",
        "$value": "16px"
      },
      "subtitle": {
        "$type": "dimension",
        "$value": "18px"
      },
      "title": {
        "$type": "dimension",
        "$value": "22px"
      },
      "heading": {
        "$type": "dimension",
        "$value": "28px"
      },
      "display": {
        "$type": "dimension",
        "$value": "34px"
      }
    },
    "weight": {
      "regular": {
        "$type": "fontWeight",
        "$value": 400
      },
      "medium": {
        "$type": "fontWeight",
        "$value": 500
      },
      "semibold": {
        "$type": "fontWeight",
        "$value": 600
      },
      "bold": {
        "$type": "fontWeight",
        "$value": 700
      }
    }
  },
  "layout": {
    "screenPadding": {
      "$type": "dimension",
      "$value": "20px"
    },
    "touchTarget": {
      "$type": "dimension",
      "$value": "44px"
    },
    "buttonHeight": {
      "$type": "dimension",
      "$value": "52px"
    },
    "inputHeight": {
      "$type": "dimension",
      "$value": "52px"
    },
    "bottomNavigationHeight": {
      "$type": "dimension",
      "$value": "68px"
    }
  },
  "opacity": {
    "disabled": {
      "$type": "number",
      "$value": 0.45
    },
    "scrim": {
      "$type": "number",
      "$value": 0.65
    }
  },
  "gradient": {
    "brand": {
      "$type": "gradient",
      "$value": [
        {
          "color": "#FED202",
          "position": 0
        },
        {
          "color": "#FEA101",
          "position": 1
        }
      ],
      "$description": "Gradiente medido no logo (p95 -> p5). So em splash, hero e ilustracao. Nunca sob texto."
    }
  }
}
