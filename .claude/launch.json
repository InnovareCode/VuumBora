{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "site",
      "runtimeExecutable": "npx.cmd",
      "runtimeArgs": [
        "-y",
        "http-server",
        "apps/site/public",
        "-p",
        "4300",
        "-c-1",
        "--silent"
