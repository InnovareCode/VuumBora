{
  "name": "vuumbora",
  "private": true,
  "version": "0.0.0",
  "description": "VuumBora — monorepo dos apps Passageiro e Motorista (Expo + React Native + TypeScript).",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=10"
  },
  "packageManager": "npm@10.9.0",
  "scripts": {
    "passenger": "npm run start --workspace @vuumbora/passenger",
    "driver": "npm run start --workspace @vuumbora/driver",
    "api": "npm run dev --workspace @vuumbora/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:docker-context": "node scripts/check-docker-context.mjs",
    "check": "npm run check:boundaries && npm run check:docker-context && npm run typecheck"
  },
  "devDependencies": {
    "typescript": "~6.0.3"
  },
  "overrides": {
    "react": "19.3.0",
    "react-native": "0.88.1"
  }
}
