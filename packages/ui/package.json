{
  "name": "@vuumbora/ui",
  "version": "0.0.0",
  "private": true,
  "description": "Componentes visuais transversais (usados pelos dois apps), consumindo apenas @vuumbora/tokens.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p tsconfig.test.json",
