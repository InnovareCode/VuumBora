    "react-native": "*",
    "react-native-safe-area-context": "*",
    "expo-linear-gradient": "*",
    "expo-image": "*",
    "expo-crypto": "*",
    "expo-secure-store": "*"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@vuumbora/api-client": "*",
    "tsx": "^4.19.2"
  }
}
